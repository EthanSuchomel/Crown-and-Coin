[{"old_text": "mage:{label:'Mage',faction:'Mythical',cost:15,", "new_text": "mage:{label:'Mage',faction:'Mythical',cost:15,maxN:2,"}, {"old_text": "Mythical:{minion:25,mage:4,", "new_text": "Mythical:{minion:25,mage:2,"}, {"old_text": "const FIELD_MAX=25, MAXN=99;", "new_text": "const FIELD_MAX=25, MAXN=99; const capOf=k=>Math.min(MAXN,TYPES[k].maxN||MAXN);   // a unit type can have its own most per army (Mage: 2)"}, {"old_text": "return '<div class=\"step\"><label for=\"'+id+'\">'+nm+'</label>'+", "new_text": "return '<div class=\"step\"><label for=\"'+id+'\">'+nm+(TYPES[key].maxN?' <small class=\"cap\">(max '+TYPES[key].maxN+')</small>':'')+'</label>'+"}, {"old_text": "min=\"0\" max=\"'+MAXN+'\" value=\"'+n+'\">'+", "new_text": "min=\"0\" max=\"'+capOf(key)+'\" value=\"'+n+'\">'+"}, {"old_text": "(n>=MAXN?' disabled':'')+'>+</button></div>';", "new_text": "(n>=capOf(key)?' disabled':'')+'>+</button></div>';"}, {"old_text": "v=Math.max(0,Math.min(MAXN,Math.round(v)||0));", "new_text": "v=Math.max(0,Math.min(capOf(k),Math.round(v)||0));"}, {"old_text": "if(TYPES[ak]) COUNTS[t][ak]+=a[k]; }", "new_text": "if(TYPES[ak]) COUNTS[t][ak]=Math.min(capOf(ak),COUNTS[t][ak]+a[k]); }"}, {"old_text": ".step label{min-width:122px;max-width:140px;line-height:1.15}", "new_text": ".step label{min-width:122px;max-width:140px;line-height:1.15}.step label .cap{font-size:12px;font-weight:500;color:var(--muted)}"}, {"old_text": "<tr><td>Mage</td><td>15 gold</td>", "new_text": "<tr><td>Mage (at most 2 per army)</td><td>15 gold</td>"}]